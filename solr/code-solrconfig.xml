<?xml version="1.0" encoding="UTF-8" ?>
<config>
  <luceneMatchVersion>9.0</luceneMatchVersion>

  <dataDir>${solr.data.dir:}</dataDir>

  <directoryFactory name="DirectoryFactory" class="${solr.directoryFactory:solr.NRTCachingDirectoryFactory}" />
  <schemaFactory class="ManagedIndexSchemaFactory">
    <bool name="mutable">false</bool>
    <str name="managedSchemaResourceName">managed-schema.xml</str>
  </schemaFactory>

  <indexConfig>
    <lockType>${solr.lock.type:native}</lockType>
  </indexConfig>

  <!-- Auto-commit: soft every 1s, hard every 15s -->
  <updateHandler class="solr.DirectUpdateHandler2">
    <updateLog>
      <str name="dir">${solr.ulog.dir:}</str>
    </updateLog>
    <autoCommit>
      <maxTime>${solr.autoCommit.maxTime:30000}</maxTime>
      <maxDocs>10000</maxDocs>
      <openSearcher>false</openSearcher>
    </autoCommit>
    <autoSoftCommit>
      <maxTime>${solr.autoSoftCommit.maxTime:5000}</maxTime>
    </autoSoftCommit>
  </updateHandler>

  <!-- Search handler: code-optimized boosting -->
  <requestHandler name="/select" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="echoParams">explicit</str>
      <str name="wt">json</str>
      <str name="defType">edismax</str>
      <str name="qf">symbol_name^4 title^3 content^2 package_name^2 tags^1.5 file_path^1</str>
      <str name="mm">75%</str>
      <int name="rows">10</int>

      <!-- Highlighting -->
      <str name="hl">on</str>
      <str name="hl.fl">content,title,symbol_name</str>
      <str name="hl.snippets">3</str>
      <str name="hl.fragsize">200</str>
      <str name="hl.tag.pre">&lt;em&gt;</str>
      <str name="hl.tag.post">&lt;/em&gt;</str>

      <!-- Faceting -->
      <str name="facet">on</str>
      <str name="facet.field">language</str>
      <str name="facet.field">doc_level</str>
      <str name="facet.field">symbol_type</str>
      <str name="facet.field">repo_id</str>
      <str name="facet.field">package_name</str>
      <str name="facet.mincount">1</str>
    </lst>
  </requestHandler>

  <!-- MoreLikeThis handler for similar code discovery -->
  <requestHandler name="/mlt" class="solr.SearchHandler">
    <lst name="defaults">
      <str name="wt">json</str>
      <str name="mlt">true</str>
      <str name="mlt.fl">content,title,tags,symbol_name</str>
      <int name="mlt.mintf">1</int>
      <int name="mlt.mindf">1</int>
      <int name="mlt.minwl">2</int>
      <int name="mlt.maxqt">25</int>
      <str name="mlt.interestingTerms">details</str>
      <int name="rows">5</int>
    </lst>
  </requestHandler>

  <!-- Update handler for JSON docs -->
  <requestHandler name="/update" class="solr.UpdateRequestHandler" />

  <requestHandler name="/update/json/docs" class="solr.UpdateRequestHandler">
    <lst name="defaults">
      <str name="stream.contentType">application/json</str>
    </lst>
  </requestHandler>

  <!-- Admin and ping handlers -->
  <requestHandler name="/admin/ping" class="solr.PingRequestHandler">
    <lst name="invariants">
      <str name="q">*:*</str>
    </lst>
    <lst name="defaults">
      <str name="echoParams">all</str>
    </lst>
  </requestHandler>

  <!-- Query parsers -->
  <queryParser name="edismax" class="solr.ExtendedDismaxQParserPlugin" />

</config>

<?xml version="1.0" encoding="UTF-8" ?>
<schema name="memories" version="1.6">

  <!-- Field Types -->
  <fieldType name="string" class="solr.StrField" sortMissingLast="true" docValues="true" />
  <fieldType name="strings" class="solr.StrField" sortMissingLast="true" multiValued="true" docValues="true" />
  <fieldType name="plong" class="solr.LongPointField" docValues="true" />
  <fieldType name="pfloat" class="solr.FloatPointField" docValues="true" />
  <fieldType name="pdate" class="solr.DatePointField" docValues="true" />
  <fieldType name="boolean" class="solr.BoolField" sortMissingLast="true" />

  <!-- Dense vectors for semantic search (cosine KNN). Dimension must match the
       embedding model. 768 = nomic-embed-text (legacy); 1024 = mxbai-embed-large
       (current). A field can't change dimension in place, so the upgrade adds a
       new field and points queries at it; the 768 field is left vestigial. -->
  <fieldType name="knn_vector_768" class="solr.DenseVectorField" vectorDimension="768" similarityFunction="cosine" />
  <fieldType name="knn_vector_1024" class="solr.DenseVectorField" vectorDimension="1024" similarityFunction="cosine" />

  <fieldType name="text_general" class="solr.TextField" positionIncrementGap="100">
    <analyzer type="index">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.WordDelimiterGraphFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="1" catenateNumbers="0" splitOnCaseChange="1" preserveOriginal="1"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt" />
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
    <analyzer type="query">
      <tokenizer class="solr.StandardTokenizerFactory"/>
      <filter class="solr.WordDelimiterGraphFilterFactory" generateWordParts="1" generateNumberParts="1" catenateWords="0" catenateNumbers="0" splitOnCaseChange="1" preserveOriginal="1"/>
      <filter class="solr.StopFilterFactory" ignoreCase="true" words="stopwords.txt" />
      <filter class="solr.SynonymGraphFilterFactory" synonyms="synonyms.txt" ignoreCase="true" expand="true"/>
      <filter class="solr.LowerCaseFilterFactory"/>
    </analyzer>
  </fieldType>

  <!-- Unique Key -->
  <uniqueKey>id</uniqueKey>

  <!-- Fields -->
  <field name="id" type="string" indexed="true" stored="true" required="true" />
  <field name="_version_" type="plong" indexed="true" stored="true" />

  <!-- Memory fields -->
  <field name="agent_id" type="string" indexed="true" stored="true" />
  <field name="memory_type" type="string" indexed="true" stored="true" />
  <field name="content" type="text_general" indexed="true" stored="true" />
  <field name="title" type="text_general" indexed="true" stored="true" />
  <field name="tags" type="strings" indexed="true" stored="true" multiValued="true" />
  <field name="source" type="string" indexed="true" stored="true" />
  <field name="importance" type="pfloat" indexed="true" stored="true" default="0.5" />
  <field name="metadata" type="text_general" indexed="true" stored="true" />
  <field name="created_at" type="pdate" indexed="true" stored="true" />
  <field name="updated_at" type="pdate" indexed="true" stored="true" />
  <field name="expires_at" type="pdate" indexed="true" stored="true" />
  <field name="lifetime" type="string" indexed="true" stored="true" default="permanent" />
  <field name="session_id" type="string" indexed="true" stored="true" />
  <field name="related_ids" type="strings" indexed="true" stored="true" multiValued="true" />
  <field name="format" type="string" indexed="true" stored="true" default="prose" />

  <!-- Retrieval feedback: how often / when a memory has actually been surfaced.
       Drives evidence-based decay and dead-memory detection. -->
  <field name="retrieval_count" type="plong" indexed="true" stored="true" default="0" />
  <field name="last_retrieved_at" type="pdate" indexed="true" stored="true" />

  <!-- Semantic embedding. stored=false so the vector never bloats query
       responses; indexed=true powers KNN. embedding=768 (legacy, vestigial),
       embedding1024=mxbai-embed-large (current, used by search). -->
  <field name="embedding" type="knn_vector_768" indexed="true" stored="false" />
  <field name="embedding1024" type="knn_vector_1024" indexed="true" stored="false" />

</schema>
